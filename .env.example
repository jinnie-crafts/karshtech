# Server Environment & Port Configuration
NODE_ENV=development
PORT=3001

# Persistent Storage Configuration
# For Render Persistent Disk, configure DATA_DIR to the mount path (e.g. /var/data)
# In local development, leave blank to use default local server/data directory
DATA_DIR=
UPLOADS_DIR=

# Security & Authentication Secrets (Must be at least 32 characters in production)
JWT_SECRET=your_32_character_minimum_secure_jwt_secret_here

# Administrative User Credentials (used only to bootstrap initial superadmin if 0 users exist)
ADMIN_USERNAME=khrgosh
ADMIN_PASSWORD=YourSecurePasswordHere!

# Web3Forms Contact Form Integration Access Key
VITE_WEB3FORMS_ACCESS_KEY=your_web3forms_access_key_here
WEB3FORMS_ACCESS_KEY=your_web3forms_access_key_here
